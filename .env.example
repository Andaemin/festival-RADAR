# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 gitignore 대상)

# MySQL 연결 문자열
# 형식: mysql://사용자:비밀번호@호스트:포트/데이터베이스명
DATABASE_URL="mysql://root:@127.0.0.1:3306/festival_radar"

# 로그인 토큰 서명용 시크릿 (lib/services/auth.service.ts 에서 사용)
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="여기에_랜덤_문자열"

# 다년도 publication-status 관리자 API/화면 활성화 여부 (기본 꺼짐 - 없으면 항상 404).
# 켜져 있어도 요청마다 ADMIN role의 JWT가 별도로 필요하다 (lib/api/require-admin.ts).
MULTIYEAR_ADMIN_UI_ENABLED="true"

# ─── 축제 기획 추천(/planner) 외부 연동 ────────────────────────────────────
# 모두 선택 사항이다. 없으면 해당 기능만 자동으로 꺼지고 나머지는 정상 동작한다.

# 한국관광공사 TourAPI 4.0 (공공데이터포털 발급 인증키 - Decoding 키를 넣을 것)
# 축제 세부 프로그램(program)과 개요(overview) 텍스트를 가져온다.
TOUR_API_SERVICE_KEY=""
# 엔드포인트가 다르면 여기서 덮어쓴다. 기본값: https://apis.data.go.kr/B551011/KorService2
TOUR_API_BASE_URL=""

# 지역N문화(한국문화원연합회) 오픈 API - 지역 설화/향토자산 스토리
# 응답 스키마 확인 전까지는 lib/external/regional-culture.ts의 FIELD_CANDIDATES가
# 느슨하게 매칭한다. REGIONAL_CULTURE_DEBUG=1 로 실제 응답 키를 로그에서 확인할 수 있다.
REGIONAL_CULTURE_SERVICE_KEY=""
REGIONAL_CULTURE_BASE_URL=""
REGIONAL_CULTURE_DEBUG=""

# OpenAI - 분석 근거를 기획안 서술로 옮기는 데만 쓴다(수치 생성 금지 프롬프트).
OPENAI_API_KEY=""
# 사용할 모델명. 미설정 시 gpt-5.5. 계정에서 쓸 수 있는 모델로 지정할 것.
OPENAI_MODEL="gpt-5.5"
